# ================================================
# LE CODE MASCULIN — Configuration Backend
# ================================================

# OBLIGATOIRE — Clé API Claude (Anthropic)
# Obtenir sur : https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-REMPLACE-PAR-TA-VRAIE-CLE

# Optionnel — Supabase (pour RAG vectoriel avancé)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optionnel — OpenAI (pour embeddings RAG)
OPENAI_API_KEY=

# Serveur
PORT=3001
NODE_ENV=development

# Formation WordPress (pc-enrollment) : en-tête X-PC-Secret de /pc-lms/v1/suspend et /enroll
PC_LMS_SECRET=
# Optionnel (défaut : https://pilierconscient.com)
PC_LMS_BASE_URL=

# Suppression de compte (DELETE /api/account) : "true" pour l'ouvrir
ENABLE_ACCOUNT_DELETE=
# Conservation 6 mois (POST /api/maintenance/retention-run, scénario Make quotidien) :
# sans "true", la tâche reste en simulation (aucun email, aucun effacement)
ENABLE_RETENTION_ERASURE=
# Brevo : clé API (effacement du contact, emails d'avertissement)
BREVO_API_KEY=
# Identifiants numériques des modèles Brevo J-30 et J-7 (paramètres : PRENOM, DATE_EFFACEMENT)
BREVO_TEMPLATE_ERASURE_J30=
BREVO_TEMPLATE_ERASURE_J7=
