# ================================================
# LE CODE MASCULIN — Configuration Backend
# ================================================

# OBLIGATOIRE — Clé API Claude (Anthropic)
# Obtenir sur : https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-REMPLACE-PAR-TA-VRAIE-CLE

# Optionnel — Supabase (pour RAG vectoriel avancé)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optionnel — OpenAI (pour embeddings RAG)
OPENAI_API_KEY=

# Serveur
PORT=3001
NODE_ENV=development

# Formation WordPress (pc-enrollment) : en-tête X-PC-Secret de /pc-lms/v1/suspend et /enroll
PC_LMS_SECRET=
# Optionnel (défaut : https://pilierconscient.com)
PC_LMS_BASE_URL=

# Stripe Customer Portal (POST /api/billing-portal)
# Optionnel : URL de retour fixée par le serveur (défaut : lecodemasculin://billing-return)
PORTAL_RETURN_URL=
# Optionnel : configuration du portail sans annulation (bpc_…) pour les clients
# dont La Transmission est en cours. Absente : ces clients reçoivent 409 transmission_plan.
STRIPE_PORTAL_CONFIG_TRANSMISSION=
